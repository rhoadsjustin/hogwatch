{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hogwatch-mcp",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-15",
  "workers_dev": true,
  "observability": { "enabled": true },
  "ratelimits": [{
    "name": "MCP_TOOL_RATE_LIMITER",
    "namespace_id": "20260816",
    "simple": { "limit": 30, "period": 60 }
  }, {
    "name": "HOGWATCH_ASK_RATE_LIMITER",
    "namespace_id": "20260817",
    "simple": { "limit": 10, "period": 60 }
  }],
  "vars": {
    "HOGWATCH_LIVE_DATA_ENABLED": "true",
    "HOGWATCH_OPENAI_MODEL": "gpt-5.6-luna",
    "HOGWATCH_OPENAI_WEB_SEARCH_FALLBACK": "false"
  },
  "kv_namespaces": [{
    "binding": "HOGWATCH_SCHEDULE_CACHE",
    "id": "e547755a5b0d4ac3b39efb412273de49"
  }]
}
