{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hogwatch-mcp",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-15",
  "workers_dev": true,
  "observability": { "enabled": true },
  "vars": {
    "HOGWATCH_LIVE_DATA_ENABLED": "true",
    "HOGWATCH_OPENAI_MODEL": "gpt-5.6-luna"
  }
}
