# Explicit opt-in: without this, HogWatch uses its clearly labeled fixture repository.
HOGWATCH_LIVE_DATA_ENABLED=false

# Disabled by default. An administrator can enable this only as a fallback if the official source is unavailable.
HOGWATCH_OPENAI_WEB_SEARCH_FALLBACK=false

# Server-only OpenAI key, required for the optional fallback and the grounded
# /api/ask endpoint. Never use NEXT_PUBLIC_ or EXPO_PUBLIC_ for this value.
OPENAI_API_KEY=

# Optional model override. The default uses the Responses web_search tool.
HOGWATCH_OPENAI_MODEL=gpt-5.6-luna

# Cloudflare Worker secret (set with: npm run deploy:worker -w @hogwatch/mcp,
# then: npx wrangler secret put OPENAI_API_KEY). Do not place it in wrangler.jsonc.

# Public Worker origin used by the native app. This contains no credentials.
# Set it in apps/mobile/.env.local for Expo, not in the Worker environment.
EXPO_PUBLIC_HOGWATCH_API_URL=https://hogwatch-mcp.<your-subdomain>.workers.dev

# Public Worker origin used by the web app's Ask panel. Same value as above and
# equally credential-free. Set it in apps/web/.env.local for Next.js.
NEXT_PUBLIC_HOGWATCH_API_URL=https://hogwatch-mcp.<your-subdomain>.workers.dev
