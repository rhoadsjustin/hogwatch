# Explicit opt-in: without this, HogWatch uses its clearly labeled fixture repository.
HOGWATCH_LIVE_DATA_ENABLED=false

# Disabled by default. An administrator can enable this only as a fallback if the official source is unavailable.
HOGWATCH_OPENAI_WEB_SEARCH_FALLBACK=false

# Server-only OpenAI key, required only for the explicit fallback above. Never use NEXT_PUBLIC_ for this value.
OPENAI_API_KEY=

# Optional model override. The default uses the Responses web_search tool.
HOGWATCH_OPENAI_MODEL=gpt-5.6-luna

# Cloudflare Worker secret (set with: npm run deploy:worker -w @hogwatch/mcp,
# then: npx wrangler secret put OPENAI_API_KEY). Do not place it in wrangler.jsonc.
